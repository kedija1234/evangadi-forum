## Server Configuration
PORT=3999

## Database Credentials
DB_USER=your_database_user
DB_PASS=your_database_password
DB_HOST=127.0.0.1
DB_NAME=your_database_name

## JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=1d


## Gemini API (Used for Vector Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
## Optional: text model for draft coach + answer fit (defaults to gemini-3.5-flash-lite)
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
## Embedding retry/backoff (free tier caps ~100 embed requests/min → 429 RESOURCE_EXHAUSTED)
GEMINI_EMBED_MAX_RETRIES=3
GEMINI_EMBED_RETRY_BASE_MS=1000
# Optional ms pause between embedding batches to stay under the per-minute quota
GEMINI_EMBED_BATCH_DELAY_MS=0



## Vector Search Thresholds & Settings
# Threshold for recommending similar questions (gemini-embedding-001: related content scores ~0.5-0.74)
# Lower = looser matches, so semantically related words/phrases are found too.
RECOMMEND_THRESHOLD=0.2
# Dashboard AI search: list only genuinely similar questions (stricter than RECOMMEND_THRESHOLD).
SEMANTIC_SEARCH_THRESHOLD=0.6
# Cap on the number of AI search results (only the top few, "very similar").
SEMANTIC_SEARCH_K=2
# Number of similar questions to return
RECOMMEND_K=10

## Answer AI ranking + recommendation (vote weight, grade thresholds)
ANSWER_RANK_AI_WEIGHT=0.5
ANSWER_RANK_VOTE_WEIGHT=0.5
# Answer grade thresholds: Good >= 0.6, Moderate >= 0.45, else Low
ANSWER_GOOD_MIN=0.6
ANSWER_MODERATE_MIN=0.45

## RAG (user-owned PDFs)
# Where PDFs are stored on disk (default uploads/rag under backend cwd)
RAG_UPLOAD_DIR=uploads/rag
# Max upload size in megabytes (keep small for classroom demos)
RAG_MAX_UPLOAD_MB=5
# Chunking: character window and overlap between windows
RAG_CHUNK_CHARS=900
RAG_CHUNK_OVERLAP=120
# Safety caps per document / per user
RAG_MAX_CHUNKS_PER_DOC=1000
RAG_MAX_PDFS_PER_USER=20
# Minimum extracted characters to treat PDF as usable text
RAG_MIN_TEXT_CHARS=50
# Semantic search: min cosine score and max hits returned
RAG_SEARCH_THRESHOLD=0.2
RAG_SEARCH_K=10
